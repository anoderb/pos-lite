# ── Frontend runtime config ──────────────────────────────
# Copy to `.env.local` and adjust. Never commit `.env.local`.

# Backend API base URL.
# Leave EMPTY for auto-detect:
#   - localhost dev  → http://127.0.0.1:5000/api
#   - deployed host  → https://api.<domain>/api
# Set explicitly in production builds:
NEXT_PUBLIC_API_URL=

# HuggingFace dataset repository used by the training pipeline
# (backend sync + admin "HF Repo" link). Format: owner/repo
NEXT_PUBLIC_HF_REPO=your-org/dataset-name

# Branding shown in UI
NEXT_PUBLIC_APP_NAME=WebPOS
NEXT_PUBLIC_APP_TAGLINE=Smart POS for modern retail